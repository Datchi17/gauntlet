# PurpleLoop SIEM settings. Copy to .env (Ansible writes this automatically).
WAZUH_VERSION=4.9.2
ZEEK_VERSION=6.0

# Host-only interface Zeek sniffs. VirtualBox host-only is usually vboxnet0.
PL_IFACE=vboxnet0

# Absolute path to the repo root, so the compose override can mount the
# detection rules and the Zeek config from the repo.
REPO_ROOT=/home/datchi/Projects/purple-loop

# The address agents connect to = this host's address ON the host-only network.
# NOTE: default vboxnet0 is 192.168.56.1. PurpleLoop assumes 10.10.0.0/24, so
# either set the host-only net to 10.10.0.1 or change this to match your setup.
PL_MANAGER_IP=10.10.0.1
